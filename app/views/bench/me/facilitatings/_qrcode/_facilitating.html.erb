<div>
  <dt><%= Bench::Facilitating.human_attribute_name(:facilitate_id) %></dt>
  <dd><%= @facilitating.facilitate.name %></dd>
</div>
<div>
  <dt><%= Bench::Facilitating.human_attribute_name(:item_id) %></dt>
  <span><%= @facilitating.item.uuid %></span>
</div>
<div>
  <dt><%= Bench::Facilitating.human_attribute_name(:member_id) %></dt>
  <span>
    <span><%= @facilitating.member&.name %></span>
  </span>
</div>
<div>
  <dt><%= Bench::Facilitating.human_attribute_name(:start_at) %></dt>
  <span class="weui-form-preview__value text-success">
    <time data-controller="time"><%= @facilitating.start_at&.to_fs(:iso8601) %></time>
  </span>
</div>
<div>
  <dt><%= Bench::Facilitating.human_attribute_name(:finish_at) %></dt>
  <span class="weui-form-preview__value text-danger">
    <time data-controller="time"><%= @facilitating.finish_at&.to_fs(:iso8601) %></time>
  </span>
</div>
