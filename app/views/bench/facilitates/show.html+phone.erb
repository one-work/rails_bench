<% if @facilitate.covers.length > 0 %>
<div class="box">
  <%= render partial: 'covers', locals: { model: @facilitate } %>
</div>
<% end %>

<dl class="box as-show">
  <div>
    <dt><%= Bench::Facilitate.human_attribute_name(:price) %></dt>
    <dd><%= @facilitate.price.to_money.format.html_safe %></dd>
  </div>
  <% if @facilitate.advance_price > 0 %>
    <div>
      <dt><%= Bench::Facilitate.human_attribute_name(:advance_price) %></dt>
      <dd><%= @facilitate.advance_price.to_money.format.html_safe %></dd>
    </div>
  <% end %>
  <div>
    <dt></dt>
    <dd><%= simple_format @facilitate.description %></dd>
  </div>
</dl>

<% if @facilitate.facilitators.present? %>
<div class="box is-padding-less">
  <div class="box-header">服务人员</div>
  <div class="p-3">
    <%= render partial: 'facilitator', collection: @facilitate.facilitators, as: :model %>
  </div>
</div>
<% end %>
