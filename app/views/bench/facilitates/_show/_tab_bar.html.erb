<div class="buttons as-bottom">
  <% if @cart %>
  <div class="flex column-gap-1">
    <%= render partial: 'cart_item', locals: { item: @cart.init_cart_item(params, good_id: @facilitate.id), cart: @cart, item_con: 'trade/my/items' } %>
    <%= link_to({ controller: 'trade/my/carts', action: 'show', id: @cart.id }, class: 'button is-primary is-radius') do %>
      <span class="mr-1"><%= t('trade.my.carts.show.title') %></span>
      <%= svg_tag 'angle-right' %>
    <% end %>
  </div>
  <% end %>
</div>
