<div class="has-block-space-around background-grey-lighter is-safe-bottom m-0 py-3" style="z-index: 500">
  <div
    data-controller="mask"
    data-action="click->mask#toggle"
    class="button is-small is-light is-radius"
  >
    <%= image_tag 'wx_moment.svg', class: 'image is-16x16' %>
    <span class="ml-1">分享</span>
  </div>
  <%= link_to current_organ.service_url, rel: 'nofollow', class: 'button is-small is-outline is-primary' do %>
    <i class="fa-solid fa-headset"></i>
    <span class="pl-1">联系客服</span>
  <% end if current_organ.service_url.present? %>
  <% if @cart %>
  <div>
    <div class="has-inline-centered">
      <%= render partial: 'cart_item', locals: { item: @cart.init_cart_item(params, good_id: @facilitate.id), cart: @cart, item_con: 'trade/my/items' } %>
    </div>
    <%= link_to({ controller: 'trade/my/carts', action: 'show', id: @cart.id }, class: 'button is-small is-primary is-radius') do %>
      <span class="mr-1"><%= t('trade.my.carts.show.title') %></span>
      <%= svg_tag 'angle-right' %>
    <% end %>
  </div>
  <% end %>
</div>
