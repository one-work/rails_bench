<p class="text-centered py-2">
  <strong><%= facilitating.facilitate.name %></strong>
</p>
<dl id="facilitating_<%= facilitating.id %>" class="as-show as-boxed">
  <% facilitating.extra.each do |k, v| %>
    <% unless k.end_with?('i)') %>
    <div>
      <dt><%= Bench::Facilitating.human_attribute_name("extra/#{k}") %></dt>
      <dd><%= v %></dd>
    </div>
    <% end %>
  <% end %>
</dl>

<%= form_with model: @order, url: { controller: 'trade/my/orders', action: 'create' }, class: 'button_column' do |f| %>
  <%= f.fields :items do |ef| %>
    <%= ef.hidden_field :good_id, value: facilitating.id %>
    <%= ef.hidden_field :good_type, value: facilitating.base_class_name %>
    <%= ef.hidden_field :good_name, value: facilitating.facilitate.name %>
    <%= ef.hidden_field :status, value: 'ordered' %>
  <% end %>
  <%= button_tag class: 'button is-outlined is-success is-block' do %>
    <div class="description text-danger">确认订单</div>
  <% end %>
<% end %>