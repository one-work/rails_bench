<p class="text-centered py-2">
  <strong><%= model.item.good_name %></strong>
</p>
<% if model.start_at.blank? || model.finish_at.blank? %>
<div>
  <figure class="image">
    <%= image_tag model.qrcode_enter_url %>
    <figcaption class="text-centered">出示二维码核销</figcaption>
  </figure>
</div>
<% end %>
<%= render partial: 'facilitating_preview', locals: { model: model } %>
<%= turbo_stream_from model %>
