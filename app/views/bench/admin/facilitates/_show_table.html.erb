<div>
  <dt><%= Bench::Facilitate.human_attribute_name(:name) %></dt>
  <dd><%= @facilitate.name %></dd>
</div>
<div>
  <dt><%= Bench::Facilitate.human_attribute_name(:description) %></dt>
  <dd><%= @facilitate.description %></dd>
</div>
<div>
  <dt><%= Bench::Facilitate.human_attribute_name(:price) %></dt>
  <dd><%= @facilitate.price %></dd>
</div>
<div>
  <dt><%= Bench::Facilitate.human_attribute_name(:card_price) %></dt>
  <dd><%= @facilitate.card_price %></dd>
</div>
<div>
  <dt><%= Bench::Facilitate.human_attribute_name(:unit) %></dt>
  <dd><%= @facilitate.unit %></dd>
</div>
<div>
  <dt><%= Bench::Facilitate.human_attribute_name(:images) %></dt>
  <dd>
  <% @facilitate.images.each do |image| %>
    <%= image_tag image.url, class: 'image is-64-w' %>
  <% end %>
  </dd>
</div>
