<%=
  tr_tag(
    model,
    {
      href: url_for(controller: 'facilitate_indicators', facilitate_id: model.id),
      icon: 'face-smile-beam',
      title: t('.facilitate_indicators.index.title')
    },
    {
      href: url_for(controller: 'facilitate_provides', facilitate_id: model.id),
      icon: 'user-magnifying-glass',
      title: t('.facilitate_provides.index.title')
    },
    {
      href: url_for(controller: 'facilitators', facilitate_id: model.id),
      icon: 'user-tie',
      title: t('.facilitators.index.title')
    }
  ) { yield }
%>
