<p class="text-centered py-2">
  <strong><%= @facilitating.item.good_name %></strong>
</p>
<% if @facilitating.start_at.blank? || @facilitating.finish_at.blank? %>
<div>
  <figure class="image">
    <%= image_tag @facilitating.qrcode_enter_url %>
    <figcaption class="text-centered">出示二维码核销</figcaption>
  </figure>
</div>
<% end %>
<%= render partial: 'facilitating_preview', locals: { model: @facilitating } %>
<%= turbo_stream_from @facilitating %>
