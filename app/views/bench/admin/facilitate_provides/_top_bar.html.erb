<h2 class="title text-centered">
  <%= @facilitate_provide.facilitate.name %>
</h2>

<div class="tabs">
  <ul>
    <li class="<%= active_helper(facilitate_providers: ['task_templates'], active: 'is-active') %>">
      <%= link_to t('.facilitate_providers.task_templates.title'), { action: 'task_templates', id: @facilitate_provide } %>
    </li>
    <li class="<%= active_helper(facilitate_providers: 'show', active: 'is-active') %>">
      <%= link_to t('.facilitate_providers.show.title'), { action: 'show', id: @facilitate_provide } %>
    </li>
  </ul>
</div>
