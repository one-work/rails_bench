<td><%= link_to model.name, { controller: 'tasks', action: 'project', project_id: model.id } %></td>
<td><%= model.description %></td>
<td>
  <p class="text-danger"><%= link_to "#{model.fund_budget}/#{model.fund_expense}", { controller: 'bench/admin/fund_budgets', action: 'index', financial_type: 'Project', financial_id: model.id } %></p>
  <p><%= link_to "#{model.budget_amount}/#{model.expense_amount}", { controller: 'bench/admin/expenses', action: 'index', project_id: model.id } %></p>
</td>
<td>
  <% model.project_mileposts.each do |project_milepost| %>
    <p><%= project_milepost.milepost_name %>: <%= project_milepost.recorded_on %></p>
  <% end %>
  <%= link_to({ controller: 'project_mileposts', action: 'new', project_id: model.id }, { class: 'button is-small is-rounded' }) do %>
    <i class="fa-solid fa-step-forward"></i>
    <span class="pl-1"><%= '下一步' %></span>
  <% end %>
</td>
<td><%= simple_format(model.extra) %></td>
<td>
  <div data-show-target="item" class="visibility-hidden">
    <%= button_to({ action: 'show', id: model.id }, aria: { label: t('.show.title') }, class: 'button is-small is-rounded is-light') do %>
      <i class="fa-solid fa-circle-info text-info"></i>
    <% end %>
    <%= button_to({ action: 'edit', id: model.id }, aria: { label: t('.edit.title') }, class: 'button is-small is-rounded is-light') do %>
      <i class="fa-solid fa-pencil text-link"></i>
    <% end %>
    <%= button_to({ action: 'destroy', id: model.id }, method: :delete, aria: { label: t('.destroy.title') }, form: { data: { turbo_confirm: t('.destroy.confirm') } }, class: 'button is-small is-rounded is-light') do %>
      <i class="fa-solid fa-trash text-danger"></i>
    <% end %>
  </div>
  <div data-show-target="item" class="visibility-hidden">
    <%= link_to({ controller: 'tasks', action: 'project', project_id: model.id }, class: 'button is-small is-rounded is-light') do %>
      <i class="fa-solid fa-list-check text-primary"></i>
      <span class="ml-1"><%= t('.tasks.project.title') %></span>
    <% end %>
  </div>
</td>