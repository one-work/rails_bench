<%= link_to({ controller: 'fund_budgets', financial_type: 'Bench::ProjectStage', financial_id: project_stage.id }, aria: { label: t('bench.admin.fund_budgets.index.title') }, class: 'button is-small is-borderless') do %>
  <i class="fa-regular fa-hand-holding-usd"></i>
<% end %>
<%= link_to({ action: 'show', id: project_stage }, aria: { label: t('.show.title') }, class: 'button is-small is-borderless') do %>
  <%= svg_tag 'eye', class: 'icon text-info' %>
<% end %>
<%= link_to({ action: 'edit', id: project_stage.id }, aria: { label: t('.edit.title') }, class: 'button is-small is-borderless') do %>
  <%= svg_tag 'pencil' %>
<% end %>
<%= link_to({ action: 'destroy', id: project_stage.id }, method: :delete, aria: { label: t('.destroy.title') }, data: { turbo_confirm: t('.destroy.confirm') }, class: 'button is-small is-borderless') do %>
  <%= svg_tag 'trash' %>
<% end %>
