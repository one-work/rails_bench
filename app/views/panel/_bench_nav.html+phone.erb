<div class="box is-padding-less">
  <div class="box-header">
    <div>
      <%= svg_tag 'user-ninja' %>
      <span><%= t('bench.panel.title') %></span>
    </div>
  </div>
  <div class="fixed-grid has-3-cols is-shadow p-3">
    <div class="grid">
      <%= link_to({ controller: 'bench/panel/taxons' }, class: 'cell has-column-centered') do %>
        <%= svg_tag 'user-ninja', class: 'icon is-medium' %>
        <div class="text-grey size-7 mt-1"><%= t('bench.panel.taxons.index.title') %></div>
      <% end %>
      <%= link_to({ controller: 'bench/panel/indicators' }, class: 'cell has-column-centered') do %>
        <%= svg_tag 'user-ninja', class: 'icon is-medium' %>
        <div class="text-grey size-7 mt-1"><%= t('bench.panel.indicators.index.title') %></div>
      <% end %>
    </div>
  </div>
</div>
