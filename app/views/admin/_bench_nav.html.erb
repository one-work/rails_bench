<div class="menu-list">
  <%= link_to({ controller: 'bench/admin/home' }, text: true, data: { turbo_frame: 'body', action: 'menu#enter' }, class: 'menu-item') do %>
    <div>
      <%= svg_tag 'share-nodes', class: 'icon' %>
      <span><%= t('bench.admin.title') %></span>
    </div>
  <% end %>
  <div class="menu-list pl-3">
    <%= link_to t('bench.admin.projects.index.title'), { controller: 'bench/admin/projects' }, data: { turbo_frame: 'body', action: 'menu#enter' }, class: active_helper(controllers: ['projects', 'taxon_indicators', 'taxon_facilitates', 'task_templates'], financial_type: 'Bench::Taxon', item: 'menu-item', active: 'menu-item is-active') %>
    <%= link_to t('bench.admin.facilitates.index.title'), { controller: 'bench/admin/facilitates' }, data: { turbo_frame: 'body', action: 'menu#enter' }, class: active_helper(controllers: ['facilitates', 'facilitate_providers', 'facilitate_indicators'], item: 'menu-item', active: 'menu-item is-active') %>
    <%= link_to t('bench.admin.facilitatings.index.title'), { controller: 'bench/admin/facilitatings' }, data: { turbo_frame: 'body', action: 'menu#enter' }, class: active_helper(controllers: ['facilitatings'], item: 'menu-item', active: 'menu-item is-active') %>
