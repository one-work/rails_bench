<div class="card as-transparent">
  <div class="card-header">
    <span class="size-7 text-grey has-border-left-primary"><%= t('bench.admin.title') %></span>
  </div>
  <div class="card-content has-4-cols">
    <div class="grid">
      <%= link_to({ controller: 'bench/admin/facilitates' }, class: 'cell has-column-centered') do %>
        <%= svg_tag 'user-tie', class: 'icon is-medium text-primary' %>
        <div class="text-grey size-7 mt-1"><%= t('bench.admin.facilitates.index.title') %></div>
      <% end %>
      <%= link_to({ controller: 'bench/admin/facilitatings' }, class: 'cell has-column-centered') do %>
        <%= svg_tag 'user-tie', class: 'icon is-medium text-primary' %>
        <div class="text-grey size-7 mt-1"><%= t('bench.admin.facilitatings.index.title') %></div>
      <% end %>
    </div>
  </div>
</div>
