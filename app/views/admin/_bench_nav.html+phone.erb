<div class="<%= role_permit?(business: 'bench', namespace: 'admin') ? 'box is-padding-less' : 'display-none' %>">
  <div class="box-body">
    <span class="size-7 has-border-left-primary"><%= t('bench.admin.title') %></span>
  </div>
  <div class="columns is-4-mobile flex is-vcentered is-centered m-0 is-shadow" data-empty-target="content">
    <%= link_to({ controller: 'bench/admin/facilitates' }, class: 'column has-column-centered') do %>
      <div class="text-primary">
        <%= svg_tag 'user-tie', class: 'icon is-medium' %>
      </div>
      <div class="text-grey size-7 mt-1"><%= t('bench.admin.facilitates.index.title') %></div>
    <% end %>
  </div>
</div>
